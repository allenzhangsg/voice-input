OPENAI_API_KEY=sk-...your-key-here...
MAX_RECORDING_SECONDS=60
MIN_RECORDING_SECONDS=0.5
LANGUAGE=en
MODEL=gpt-4.1-mini

# Translation mode: speak any language, insert in target language
# Quick-tap Right Option to toggle at runtime
TRANSLATE=false
TRANSLATE_TARGET=English

# Live preview: stream audio to the OpenAI Realtime API and type partial
# transcripts into the focused field as you speak, then replace them with the
# formatted text once you stop. Set to false to keep the classic behaviour
# (record, then insert only the final formatted text via Whisper).
REALTIME=true
# Transcription model for the realtime stream: gpt-4o-transcribe (most accurate)
# or gpt-4o-mini-transcribe (faster, cheaper).
REALTIME_MODEL=gpt-4o-transcribe
