OPENAI_API_KEY=sk-...your-key-here...
MAX_RECORDING_SECONDS=60
MIN_RECORDING_SECONDS=0.5
LANGUAGE=en
MODEL=gpt-4.1-mini

# Translation mode: speak any language, insert in target language
# Quick-tap Right Option to toggle at runtime
TRANSLATE=false
TRANSLATE_TARGET=English

# Live preview: type partial transcripts into the focused field while you speak,
# then replace them with the formatted text once you stop. Set to false to keep
# the classic behaviour (insert only the final formatted text).
REALTIME=true
REALTIME_INTERVAL_MS=2000
